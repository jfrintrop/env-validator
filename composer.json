{
    "name": "jfrintrop/env-validator",
    "description": "Validate your environment variables against a schema — fail fast at boot or in CI, using the Laravel validation rules you already know.",
    "keywords": [
        "env",
        "dotenv",
        "environment",
        "config",
        "validation",
        "laravel",
        "ci",
        "fail-fast",
        "php",
        "laravel-package",
        "env-validator",
        "environment-variables",
        "env-example",
        "validator"
    ],
    "homepage": "https://github.com/jfrintrop/env-validator",
    "license": "MIT",
    "authors": [
        {
            "name": "J. Frintrop",
            "email": "jfrintrop@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/validation": "^10.0|^11.0|^12.0",
        "illuminate/translation": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "Jfrintrop\\EnvValidator\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Jfrintrop\\EnvValidator\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Jfrintrop\\EnvValidator\\Laravel\\EnvValidatorServiceProvider"
            ],
            "aliases": {
                "EnvValidator": "Jfrintrop\\EnvValidator\\Laravel\\Facades\\EnvValidator"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
